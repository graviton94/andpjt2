-    const val SAVE_VERSION = 1
+    const val SAVE_VERSION = 2
@@ -33 +37,24 @@ object SaveCodec {
-        return json.decodeFromJsonElement(GameState.serializer(), root["state"]!!)
+        val state = root.getValue("state").jsonObject
+        if (version == SAVE_VERSION) return json.decodeFromJsonElement(GameState.serializer(), state)
+        val migrated = migrateExactAmounts(state)
+        val game = json.decodeFromJsonElement(GameState.serializer(), migrated)
+        val cloud = game.backup.cloud
+        val retired = cloud.lv(CloudItem.ValueCap)
+        if (retired == 0) return game
+        val refund = (0 until retired.coerceAtMost(CloudItem.ValueCap.max)).fold(BigInteger.ZERO) { total, rank ->
+            total + RuleSet().cloudPrice(CloudItem.ValueCap, rank)
+        }
+        return game.copy(backup = game.backup.copy(cloud = cloud.copy(
+            gb = cloud.gb + refund, items = cloud.items - CloudItem.ValueCap,
+        )))
+    }
+
+    private fun migrateExactAmounts(state: JsonObject): JsonObject {
+        val backup = state["backup"]?.jsonObject ?: return state
+        fun exact(objectValue: JsonObject, fields: Set<String>) = objectValue.mapValues { (name, value) ->
+            if (name in fields) JsonPrimitive(value.jsonPrimitive.content) else value
+        }
+        val oldCloud = backup["cloud"]?.jsonObject
+        val updated = exact(backup, setOf("files", "lifetime")).toMutableMap()
+        if (oldCloud != null) updated["cloud"] = JsonObject(exact(oldCloud, setOf("gb", "lifetime", "bestCycleFiles")))
+        return JsonObject(state + ("backup" to JsonObject(updated)))
