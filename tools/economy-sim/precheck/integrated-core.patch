@@ -0,0 +1,15 @@
+package com.graviton94.notificationcleaner.core
+
+object ExOffers {
+    const val unitPriceWon = 3_300
+    val ids = listOf("prism_trail", "prism_wave", "prism_theme", "reboot_frame", "reboot_theme", "reboot_sync",
+        "studio_deck", "studio_star", "studio_pro")
+    private val sets = ids.chunked(3)
+
+    fun completed(owned: Set<String>): Int = sets.count { owned.containsAll(it) }
+
+    fun extraCapMs(s: GameState, completed: Int): Long {
+        val ranks = s.backup.lv(BackupItem.Offline).toLong() + s.backup.cloud.lv(CloudItem.CloudOffline)
+        return minOf(84, 2L * completed * ranks) * 60_000
+    }
+}
