diff --git a/core/src/main/kotlin/com/graviton94/notificationcleaner/core/IntegratedGrowth.kt b/core/src/main/kotlin/com/graviton94/notificationcleaner/core/IntegratedGrowth.kt
new file mode 100644
index 0000000..42ba12e
--- /dev/null
+++ b/core/src/main/kotlin/com/graviton94/notificationcleaner/core/IntegratedGrowth.kt
@@ -0,0 +1,125 @@
+package com.graviton94.notificationcleaner.core
+
+import java.math.BigDecimal
+import java.math.BigInteger
+import java.math.BigInteger.ONE
+import java.math.BigInteger.TEN
+import java.math.BigInteger.ZERO
+import java.util.concurrent.ConcurrentHashMap
+
+private fun number(n: Long) = BigInteger.valueOf(n)
+
+/** Extend the live threshold sequence, preserving each of its independently rounded terms. */
+internal class ExtendedLevels(private val rules: RuleSet) {
+    private var exact = BigDecimal.valueOf(rules.levelPBase)
+    private var ratio = rules.levelRatioPermille.toLong()
+    @Volatile private var thresholds = listOf(ZERO, ZERO)
+    private val fastBoots = ConcurrentHashMap<Int, Pair<BigInteger, BigInteger>>()
+
+    fun threshold(level: Int): BigInteger {
+        val wanted = level.coerceAtLeast(1)
+        return thresholds.getOrNull(wanted) ?: extend(wanted, null)[wanted]
+    }
+
+    @Synchronized
+    private fun extend(wanted: Int, untilPast: BigInteger?): List<BigInteger> {
+        val values = thresholds.toMutableList()
+        while (values.lastIndex < wanted || (untilPast != null && values.last() <= untilPast)) {
+            val level = values.size
+            values.add(exact.toBigInteger())
+            if (level >= rules.levelLateFrom) ratio += rules.levelRatioStepPermille
+            exact = exact * BigDecimal.valueOf(ratio) / BigDecimal.valueOf(1_000)
+        }
+        thresholds = values
+        return values
+    }
+
+    private fun fastBoot(fastBoot: Int) = fastBoots.computeIfAbsent(fastBoot) {
+        TEN.pow(it) to number(9).pow(it)
+    }
+
+    fun level(p: BigInteger, fastBoot: Int): Int {
+        val adjusted = if (fastBoot == 0) p else {
+            val (num, den) = fastBoot(fastBoot)
+            p * num / den
+        }
+        val current = thresholds
+        val values = if (current.last() > adjusted) current else extend(1, adjusted)
+        var low = 1
+        var high = values.lastIndex
+        while (low < high) {
+            val mid = low + (high - low + 1) / 2
+            if (values[mid] <= adjusted) low = mid else high = mid - 1
+        }
+        return low
+    }
+
+    fun ceiling(level: Int, fastBoot: Int): BigInteger {
+        val p = threshold(level)
+        if (fastBoot == 0) return p
+        val (num, den) = fastBoot(fastBoot)
+        return (p * den + num - ONE) / num
+    }
+}
+
+internal object ExactGrowth {
+    private val thousand = number(1_000)
+    private val million = number(1_000_000)
+    private val hundred = number(100)
+
+    fun price(base: Long, growth: Int, owned: Int): BigInteger {
+        val denominator = thousand.pow(owned)
+        val numerator = number(base) * number(growth.toLong()).pow(owned)
+        return (numerator + denominator - ONE) / denominator
+    }
+
+    private fun nthRoot(value: BigInteger, degree: Int): BigInteger {
+        if (degree == 2) return value.sqrt()
+        if (value <= ONE) return value
+        var x = ONE.shiftLeft((value.bitLength() - 1) / degree + 1)
+        val d = number(degree.toLong())
+        while (true) {
+            val next = (x * (d - ONE) + value / x.pow(degree - 1)) / d
+            if (next >= x) return x
+            x = next
+        }
+    }
+
+    fun backupTotal(rules: RuleSet, p: BigInteger): BigInteger {
+        check(rules.backupExponentPermille == 400)
+        val anchor = rules.levelP(rules.resetLevel)
+        if (p < anchor) return ZERO
+        val transition = TEN.pow(rules.backupSoftcapDigits)
+        val scale = number(rules.backupBase).pow(5)
+        val numerator = if (p <= anchor * transition) scale * p.pow(2) / anchor.pow(2)
+            else scale * transition * p / anchor
+        return nthRoot(numerator, 5)
+    }
+
+    fun fileAfterCloud(rules: RuleSet, base: BigInteger, cloud: Cloud): BigInteger {
+        val rank = cloud.lv(CloudItem.Compression)
+        val numerator = base.pow(2) * number(9).pow(rank) *
+            (hundred + number(rules.cloudFilePercent.toLong()) * cloud.lifetime)
+        return (numerator / (number(4).pow(rank) * hundred)).sqrt()
+    }
+
+    fun cloudTotal(rules: RuleSet, files: BigInteger): BigInteger {
+        check(rules.cloudExponentPermille == 500)
+        val anchor = backupTotal(rules, rules.levelP(rules.syncLevel))
+        if (files < anchor || anchor.signum() == 0) return ZERO
+        return (number(rules.cloudBase).pow(2) * files / anchor).sqrt()
+    }
+
+    private data class Passive(val lifetime: BigInteger, val percent: Int, val result: BigInteger)
+    private val passiveCache = ThreadLocal<Passive>()
+
+    fun passive(rules: RuleSet, files: BigInteger): BigInteger {
+        check(rules.lifetimeExponentPermille == 850)
+        val percent = rules.lifetimeFilePercent
+        passiveCache.get()?.let { if (it.lifetime == files && it.percent == percent) return it.result }
+        val numerator = (hundred + number(percent.toLong()) * files).pow(17) * (million * BigInteger.TWO).pow(20)
+        val result = (nthRoot(numerator / hundred.pow(17), 20) + ONE) / BigInteger.TWO
+        passiveCache.set(Passive(files, percent, result))
+        return result
+    }
+}
