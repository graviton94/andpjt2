+import java.math.BigInteger.TEN
+import java.math.BigInteger.ZERO
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+
+object IntegratedAudit {
+    @JvmStatic
+    fun main(args: Array<String>) {
+        val directory = File(args[0])
+        val engine = Engine()
+        val rules = engine.rules
+        val shop = Shop(engine)
+        val meta = Meta(engine)
+        val now = 1_728_000_000_000L
+        val checks = mutableListOf<List<Any>>()
+
+        val old = """{"save":1,"state":${SaveCodec.encode(engine.newGame(now, 17)).substringAfter("\"state\":").dropLast(1).dropLast(1)},"backup":{"files":123,"lifetime":456,"cloud":{"gb":19,"lifetime":23,"bestCycleFiles":71,"items":{"ValueCap":2}}}}}"""
+        val migrated = SaveCodec.decode(old)
+        val refund = rules.cloudPrice(CloudItem.ValueCap, 0) + rules.cloudPrice(CloudItem.ValueCap, 1)
+        check(migrated.backup.files == BigInteger.valueOf(123) && migrated.backup.lifetime == BigInteger.valueOf(456))
+        check(migrated.backup.cloud.gb == BigInteger.valueOf(19) + refund)
+        check(migrated.backup.cloud.lv(CloudItem.ValueCap) == 0)
+        check(SaveCodec.decode(SaveCodec.encode(migrated)) == migrated)
+        checks.add(listOf("legacy_save_and_single_refund", refund, migrated.backup.cloud.gb))
+
+        val initial = engine.newGame(now, 17)
+        val first = ExOffers.ids.first()
+        check(shop.buyEx(initial, first, "") == null && shop.buyEx(initial, "unknown", "test") == null)
+        var owned = checkNotNull(shop.buyEx(initial, first, "test-0"))
+        check(shop.buyEx(owned, first, "other") == null)
+        check(shop.buyEx(owned, ExOffers.ids[1], "test-0") == null)
+        for ((index, sku) in ExOffers.ids.withIndex().drop(1)) owned = checkNotNull(shop.buyEx(owned, sku, "test-$index"))
+        check(owned.account.ownedEx.size == 9 && ExOffers.completed(owned.account.ownedEx) == 3)
+        checks.add(listOf("receipt_and_ownership", owned.account.ownedEx.size, owned.account.processedClaims.size))
+
+        val richCloud = Cloud(items = mapOf(CloudItem.SyncValue to 2_600, CloudItem.Compression to 75,
+            CloudItem.CloudOffline to 20), syncs = 4)
+        val stress = owned.copy(level = 998, runEarned = rules.levelP(998),
+            backup = Backup(files = TEN.pow(300), resets = 1, items = mapOf(BackupItem.Offline to 20, BackupItem.Value to 400),
+                cloud = richCloud.copy(account = owned.account)))
+        val swipe = checkNotNull(engine.swipe(stress, 4, now + 3_000))
+        check(swipe.earned.signum() > 0 && swipe.state.level > 1_000)
+        val capQuote = engine.backupPrice(swipe.state, BackupItem.Value)
+        check(capQuote > BigInteger.valueOf(Long.MAX_VALUE))
+        val buy = engine.buyBackup(swipe.state, BackupItem.Value)
+        check(buy.backup.lv(BackupItem.Value) == 401 && swipe.state.backup.files - buy.backup.files == capQuote)
+        val reset = checkNotNull(engine.factoryReset(buy, now))
+        check(reset.backup.lifetime > BigInteger.valueOf(Long.MAX_VALUE) && reset.account.ownedEx == owned.account.ownedEx)
+        val sync = checkNotNull(engine.sync(reset.copy(level = swipe.state.level, runEarned = swipe.state.runEarned), now))
+        check(sync.backup.cloud.gb > BigInteger.valueOf(Long.MAX_VALUE) && sync.account.ownedEx == owned.account.ownedEx)
+        checks.add(listOf("large_wallet_swipe_purchase_and_prestige", swipe.state.level,
+            "${capQuote.toString().length} price digits / ${reset.backup.lifetime.toString().length} file digits / ${sync.backup.cloud.gb.toString().length} GB digits"))
+        val snapshot = Json.parseToJsonElement(WebSession(state = reset, now = now).snapshot(now)).jsonObject
+        check(snapshot.getValue("filesExact").jsonPrimitive.content == reset.backup.files.toString())
+
+        val cappedRoom = owned.copy(earnRate = BigInteger.valueOf(108_000), exNeutralRate = BigInteger.valueOf(100_000),
+            backup = owned.backup.copy(items = mapOf(BackupItem.Offline to 2)))
+        val away = 12 * 3_600_000L
+        val payout = engine.settleOfflineWithBonus(cappedRoom, away, now).paid
+        check(payout == BigInteger.valueOf(1_848_000))
+        val boosted = cappedRoom.withAccount { it.copy(overclockUntil = now, ownedEx = emptySet()) }
+            .copy(earnRate = BigInteger.valueOf(100_000), exNeutralRate = null)
+        val strict = engine.settleOfflineWithBonus(boosted, away, now).paid
+        check(strict == BigInteger.valueOf(5_040_000))
+        checks.add(listOf("offline_ex_budget_and_clock_bound", payout, strict))
+
+        val stars = Catalog.starter.associateWith { 5 }
+        val starred = owned.withAccount { it.copy(premium = stars) }
+        val (participant, board) = checkNotNull(meta.startChallenge(starred, now))
+        check(board.account.ownedEx.isEmpty() && board.account.premium.isEmpty() && board.challengeStarsAtStart == 15)
+        val done = meta.finishChallenge(participant.withAccount { it.copy(premium = emptyMap()) },
+            board.copy(runEarned = BigInteger.valueOf(100_000)))
+        check(done.account.challengeBest == "100000" && done.account.challengeAdjustedBest == "101500")
+        checks.add(listOf("challenge_star_snapshot_and_separate_record", done.account.challengeBest, done.account.challengeAdjustedBest))
+
+        var yearly = sync
+        val day = 86_400_000L
+        repeat(365) { elapsed ->
+            repeat(12) { ad ->
+                yearly = checkNotNull(shop.claimAdOnce(yearly, "device-ad-$elapsed-$ad", now + elapsed * day) { it })
+            }
+        }
+        val saved = SaveCodec.encode(yearly)
+        check(SaveCodec.decode(saved) == yearly && saved.toByteArray().size <= 20 * 1024)
+        checks.add(listOf("save_round_trip_ads_and_ex", saved.toByteArray().size, yearly.account.ownedEx.size))
+        csv(File(directory, "integrated-fixtures.csv"), listOf("check", "observed", "detail"), checks.asSequence())
+    }
+}
