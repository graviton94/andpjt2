+    @Test
+    fun capacityPurchasesContinuePastBothPreviousLimits() {
+        val game = e.newGame(now, 17, Backup(files = valueOf(1_000_000), resets = 1,
+            items = mapOf(BackupItem.Offline to 10),
+            cloud = Cloud(gb = valueOf(1_000_000), syncs = 4, items = mapOf(CloudItem.CloudOffline to 4))))
+        val first = e.buyBackup(game, BackupItem.Offline)
+        val second = e.buyCloud(first, CloudItem.CloudOffline)
+        assertEquals(11, first.backup.lv(BackupItem.Offline))
+        assertEquals(5, second.backup.cloud.lv(CloudItem.CloudOffline))
+        assertEquals(3_600_000L, e.offlineCapMs(first) - e.offlineCapMs(game))
+        assertEquals(3_600_000L, e.offlineCapMs(second) - e.offlineCapMs(first))
+        assertEquals(e.offlinePercent(game), e.offlinePercent(second))
+    }
+
+    @Test
+    fun lowTierAppStillGetsAPaidMilestoneAfterLevel500() {
+        val app = Catalog.app("memo")
+        val startLevel = 599
+        val game = e.newGame(now, 17).copy(appLevels = Catalog.starter.associateWith { if (it == app.id) startLevel else 1 },
+            wallet = e.rules.upgradePrice(app, startLevel))
+        val after = e.upgrade(game, app.id)
+        assertEquals(600, after.appLevels.getValue(app.id))
+        assertEquals(BigInteger.ZERO, after.wallet)
+        assertTrue(e.rules.upgradePrice(app, 600) > e.rules.upgradePrice(app, 599))
+        assertTrue(e.earn(after, app.id, valueOf(1_000), 0) >= e.earn(game, app.id, valueOf(1_000), 0) * valueOf(2))
