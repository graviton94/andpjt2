+    @Test
+    fun experimentalOffersReachActualSwipePrestigeAndReturnSettlement() {
+        val now = 700_000_000L
+        val owned = ExOffers.ids.toSet()
+        val engine = Engine(RuleSet(growthOffer = GrowthOffer.Prestige))
+        val base = engine.newGame(now, 17)
+        val equipped = base.withAccount { it.copy(ownedEx = owned) }
+        val target = requireNotNull(engine.bestTarget(base, now))
+        val noEx = requireNotNull(engine.swipe(base, target, now))
+        val swipe = WebSession(engine, equipped, now).swipe(target, now)
+        val result = Json.parseToJsonElement(swipe).jsonObject
+        val paid = BigInteger(result.getValue("earned").jsonPrimitive.content)
+        assertTrue(paid > noEx.earned)
+        assertEquals((paid - noEx.earned).toString(), result.getValue("exExtraP").jsonPrimitive.content)
+
+        val high = equipped.copy(level = 110, runEarned = engine.rules.levelP(110))
+        val reset = WebSession(engine, high, now)
+        val payout = Json.parseToJsonElement(reset.reset(now)).jsonObject
+        assertTrue(BigInteger(payout.getValue("exExtraFilesExact").jsonPrimitive.content).signum() > 0)
+        val restored = SaveCodec.decode(reset.save())
+        assertEquals(owned, restored.account.ownedEx)
+        val repeated = restored.copy(level = high.level, runEarned = high.runEarned)
+        assertEquals(BigInteger.ZERO, engine.factoryResetPaid(repeated, now, true))
+        val synced = Json.parseToJsonElement(WebSession(engine, repeated, now).sync(now)).jsonObject
+        assertTrue(BigInteger(synced.getValue("exExtraGbExact").jsonPrimitive.content).signum() > 0)
+
+        val discount = Engine(RuleSet(growthOffer = GrowthOffer.Discount))
+        val returning = high.copy(earnRate = BigInteger.valueOf(100_000), appLevels = high.appLevels + ("memo" to 100))
+        val offline = discount.settleOfflineWithBonus(returning, 15L * 3_600_000, now)
+        assertEquals(147L * 60_000, offline.eligibleMs - offline.baseEligibleMs)
+        assertTrue(offline.exExtraP.signum() > 0)
+        assertTrue(discount.upgradePrice(returning, "memo") < discount.upgradePrice(returning.withAccount { it.copy(ownedEx = emptySet()) }, "memo"))
+    }
+    @Test
+    fun quoteStartsFromInheritedValueAndStaysFixedInsideTheRun() {
+        val engine = Engine(RuleSet(appRankValuePermille = 1_200, indexUpgradePricesOnReset = true))
+        val now = 700_000_000L
+        val plain = engine.newGame(now, 17)
+        val inherited = Backup(cloud = Cloud(items = mapOf(CloudItem.SyncValue to 12)))
+        val strong = engine.newGame(now, 17, inherited)
+        val oldQuote = engine.upgradePrice(plain, "memo")
+        val incurred = engine.upgradePrice(strong, "memo")
+        assertTrue(incurred > oldQuote)
+        assertTrue(incurred < oldQuote * BigInteger.TWO.pow(12))
+        assertEquals(incurred, engine.upgradePrice(strong.copy(backup = Backup()), "memo"))
+        assertEquals(incurred, engine.upgradePrice(SaveCodec.decode(SaveCodec.encode(strong)), "memo"))
+    }
