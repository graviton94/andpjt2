+    @Test
+    fun offersComposeExactlyAndIncreaseWithSetCompletion() {
+        val base = BigInteger.TEN.pow(400)
+        val sets = listOf(
+            emptySet(), setOf(ExOffers.ids[0]), setOf(ExOffers.ids[0], ExOffers.ids[3], ExOffers.ids[6]),
+            ExOffers.ids.take(3).toSet(), ExOffers.ids.take(6).toSet(), ExOffers.ids.toSet(),
+        )
+        for (offer in GrowthOffer.entries) {
+            assertEquals(base, offer.income(base, sets.first()))
+            assertEquals(base, offer.prestige(base, sets.first()))
+            assertEquals(base, offer.price(base, sets.first()))
+            for ((before, after) in sets.zipWithNext()) {
+                assertTrue(offer.income(base, after) > offer.income(base, before))
+                assertTrue(offer.prestige(base, after) >= offer.prestige(base, before))
+                assertTrue(offer.price(base, after) <= offer.price(base, before))
+            }
+        }
+        assertEquals(147, GrowthOffer.Discount.offlineMinutes(sets.last()))
+        assertEquals(0, GrowthOffer.Prestige.offlineMinutes(sets.last()))
+    }
