+++ b/core/src/test/kotlin/com/graviton94/notificationcleaner/core/HugeNumberContractTest.kt
@@ -0,0 +1,129 @@
+package com.graviton94.notificationcleaner.core
+
+import java.math.BigInteger
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.boolean
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertTrue
+
+class HugeNumberContractTest {
+    @Test
+    fun bigQuotesAndAffordabilityUseExactIntegerValues() {
+        val engine = Engine()
+        val now = 2_000_000L
+        val huge = BigInteger.TEN.pow(400)
+        val start = engine.newGame(now, 17, Backup(files = huge, resets = 5, cloud = Cloud(gb = huge, syncs = 4)))
+        val states = start.copy(level = 800, runEarned = engine.rules.levelP(800),
+            appLevels = start.appLevels + ("memo" to 3_100), bestSwipe = huge)
+        val exactPrice = engine.upgradePrice(states, "memo")
+        assertTrue(exactPrice.toString().length > 308)
+        val below = WebSession(engine, states.copy(wallet = exactPrice - BigInteger.ONE), now)
+        val exact = WebSession(engine, states.copy(wallet = exactPrice), now)
+        fun row(session: WebSession, list: String, id: String) =
+            Json.parseToJsonElement(session.panel(now)).jsonObject.getValue(list).jsonArray
+                .map { it.jsonObject }.first { it.getValue("id").jsonPrimitive.content == id }
+        val app = row(exact, "apps", "memo")
+        assertEquals(exactPrice.toString(), app.getValue("price1").jsonPrimitive.content)
+        assertEquals(short(exactPrice), app.getValue("price1Short").jsonPrimitive.content)
+        assertTrue(app.getValue("canUpgrade").jsonPrimitive.boolean)
+        assertFalse(row(below, "apps", "memo").getValue("canUpgrade").jsonPrimitive.boolean)
+        assertTrue(row(exact, "cloudShop", "CloudOffline").getValue("canBuy").jsonPrimitive.boolean)
+        val snap = Json.parseToJsonElement(exact.snapshot(now)).jsonObject
+        for (name in listOf("files", "gb")) {
+            assertEquals(huge.toString(), snap.getValue(name + "Exact").jsonPrimitive.content)
+            assertEquals(short(huge), snap.getValue(name + "Short").jsonPrimitive.content)
+        }
+        assertEquals(short(huge), snap.getValue("bestSwipeShort").jsonPrimitive.content)
