index 0000000..c9f8e72
--- /dev/null
+++ b/core/src/main/kotlin/com/graviton94/notificationcleaner/core/GrowthOffer.kt
@@ -0,0 +1,30 @@
+package com.graviton94.notificationcleaner.core
+
+import java.math.BigInteger
+
+/** Exact factor composition for the two review offers. Runtime selection follows user review. */
+enum class GrowthOffer(val sku: GrowthEffect, val set: GrowthEffect, val complete: GrowthEffect) {
+    Prestige(GrowthEffect(1_075, 1_020, 1_000), GrowthEffect(1_160, 1_060, 1_000), GrowthEffect(1_080, 1_100, 1_000)),
+    Discount(GrowthEffect(1_070, 1_000, 975, 8), GrowthEffect(1_130, 1_000, 965, 25), GrowthEffect(1_150, 1_000, 970));
+
+    fun income(base: BigInteger, owned: Set<String>) = scale(base, owned, GrowthEffect::income)
+    fun prestige(base: BigInteger, owned: Set<String>) = scale(base, owned, GrowthEffect::prestige)
+    fun price(base: BigInteger, owned: Set<String>) = scale(base, owned, GrowthEffect::price).max(BigInteger.ONE)
+    fun offlineMinutes(owned: Set<String>): Int {
+        val n = ExOffers.ids.count { it in owned }
+        return sku.offlineMinutes * n + set.offlineMinutes * ExOffers.completed(owned) +
+            if (n == ExOffers.ids.size) complete.offlineMinutes else 0
+    }
+
+    private fun scale(base: BigInteger, owned: Set<String>, factor: (GrowthEffect) -> Int): BigInteger {
+        val n = ExOffers.ids.count { it in owned }
+        val groups = ExOffers.completed(owned)
+        val all = if (n == ExOffers.ids.size) 1 else 0
+        val multiplier = big(factor(sku)).pow(n) * big(factor(set)).pow(groups) * big(factor(complete)).pow(all)
+        return base * multiplier / big(1_000).pow(n + groups + all)
+    }
+
+    private fun big(n: Int) = BigInteger.valueOf(n.toLong())
+}
+
+data class GrowthEffect(val income: Int, val prestige: Int, val price: Int, val offlineMinutes: Int = 0)
