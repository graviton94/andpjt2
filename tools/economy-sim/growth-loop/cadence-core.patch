+++ b/core/src/test/kotlin/com/graviton94/notificationcleaner/core/CadenceContractTest.kt
@@ -0,0 +1,114 @@
+package com.graviton94.notificationcleaner.core
+
+import java.math.BigInteger
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertTrue
+
+class CadenceContractTest {
+    @Test
+    fun pricesKeepTheEarlierBandAndTheFrozenQuoteSurvivesSave() {
+        val engine = Engine(RuleSet(frontierPrices = true))
+        val now = 10_000_000L
+        val start = engine.newGame(now, 17, Backup(qualifiedAppPeaks = mapOf("memo" to 80),
+            cloud = Cloud(items = mapOf(CloudItem.SyncValue to 20))))
+        fun price(level: Int): BigInteger {
+            val copy = start.copy(appLevels = start.appLevels + ("memo" to level))
+            val saved = SaveCodec.decode(SaveCodec.encode(copy))
+            assertEquals(start.frontierPricePermille, saved.frontierPricePermille)
+            return engine.upgradePrice(saved, "memo")
+        }
+        val memo = Catalog.app("memo")
+        assertEquals(engine.rules.upgradePrice(memo, 80), price(80))
+        assertTrue(price(104) > engine.rules.upgradePrice(memo, 104))
+        assertTrue((80..103).all { price(it + 1) >= price(it) })
+    }
+
+    @Test
+    fun productiveFloorNeedsFreshPlayAndDoesNotDebitTheRecordAmount() {
+        val engine = Engine(RuleSet(productivePrestige = true, growthOffer = GrowthOffer.Discount))
+        val now = 10_000_000L
+        val p = engine.rules.levelP(25)
+        val before = engine.newGame(now, 9, Backup(bestRunP = p, lifetime = BigInteger.TEN,
+            baseFilesClaimed = BigInteger.TEN)).copy(level = 25, runEarned = p, prestigePlayMs = 720_000)
+        val beforeRecord = before.backup.baseFilesClaimed
+        assertTrue(engine.factoryResetPaid(before, now, true).signum() > 0)
+        val after = checkNotNull(engine.factoryReset(before, now))
+        assertEquals(beforeRecord, after.backup.baseFilesClaimed)
+        val repeated = SaveCodec.decode(SaveCodec.encode(after)).copy(level = 25, runEarned = p)
+        assertEquals(BigInteger.ZERO, engine.factoryResetPaid(repeated, now, true))
+    }
+
+    @Test
+    fun offlineReturnsCapacityAndCreditedTimeIndependently() {
+        val engine = Engine(RuleSet(growthOffer = GrowthOffer.Discount))
+        val now = 800_000_000L
+        val start = engine.newGame(now, 1).copy(level = 36, runEarned = engine.rules.levelP(36),
+            earnRate = BigInteger.valueOf(1_000_000)).withAccount { it.copy(ownedEx = ExOffers.ids.toSet()) }
+        val upgraded = start.copy(backup = start.backup.copy(items = mapOf(BackupItem.Offline to 12),
+            cloud = start.backup.cloud.copy(items = mapOf(CloudItem.CloudOffline to 7))))
+        assertEquals(19 * 3_600_000L, engine.offlineCapMs(upgraded) - engine.offlineCapMs(start))
+        assertEquals(engine.offlineCapMs(upgraded), engine.offlineCapMs(SaveCodec.decode(SaveCodec.encode(upgraded))))
+        fun settle(hours: Long) = Json.parseToJsonElement(WebSession(engine, start, now)
+            .offline(hours * 3_600_000L, now)).jsonObject
+        for ((hours, credited) in listOf(6L to 0L, 15L to 8_820_000L)) {
+            val response = settle(hours)
+            assertEquals("43200000", response.getValue("baseOfflineCapMs").jsonPrimitive.content)
+            assertEquals("8820000", response.getValue("exExtraOfflineCapMs").jsonPrimitive.content)
+            assertEquals(credited.toString(), response.getValue("exExtraEligibleMs").jsonPrimitive.content)
+            assertTrue("exExtraPShort" in response)
+            System.getenv("NC_OFFLINE_UI_OUT")?.let { target ->
+                val dir = java.io.File(target).also { it.mkdirs() }
+                java.io.File(dir, "return-${hours}h.json").writeText(response.toString() + "\n")
+            }
+        }
+    }
+    @Test
+    fun repeatSyncRequiresAFirstSyncAndFreshQualifiedActivity() {
+        val engine = Engine(RuleSet(repeatSync = true, productivePrestige = true))
+        val now = 80_000_000L
+        fun state(syncs: Int) = engine.newGame(now, 17, Backup(playedPrestigeMs = 1_500_000,
+            cloud = Cloud(syncs = syncs))).copy(level = 25, runEarned = engine.rules.levelP(25))
+        assertTrue(!engine.canSync(state(0)))
+        val before = state(1)
+        assertTrue(engine.canSync(before))
+        assertTrue(engine.syncPaid(before, now, true).signum() > 0)
+        val after = checkNotNull(engine.sync(before, now)).copy(level = 25)
+        assertTrue(!engine.canSync(after))
+        assertEquals(BigInteger.ZERO, engine.syncPaid(after, now, true))
+    }
+    @Test
+    fun cloudRetainsOnlyTheLargestFileRecordAndRestoresTheIncome() {
+        val engine = Engine(RuleSet(productivePrestige = true, repeatSync = true, inheritRecordIncome = true))
+        val now = 80_000_000L
+        val record = BigInteger.TEN.pow(8)
+        val previous = engine.newGame(now, 17, Backup(playedPrestigeMs = 1_500_000,
+            baseFilesClaimed = record, cloud = Cloud(syncs = 1))).copy(level = 25)
+        val after = checkNotNull(engine.sync(previous, now))
+        val decoded = SaveCodec.decode(SaveCodec.encode(after))
+        assertEquals(record, decoded.backup.cloud.retainedRecordFiles)
+        val memo = Catalog.app("memo")
+        val (n,d) = engine.rules.baseValue(memo, 1, decoded.backup)
+        val (n0,d0) = RuleSet().baseValue(memo, 1, decoded.backup)
+        assertTrue(n * d0 > n0 * d)
+        val again = decoded.copy(level = 25, prestigePlayMs = 1_500_000)
+        assertEquals(record, checkNotNull(engine.sync(again, now)).backup.cloud.retainedRecordFiles)
+    }
+    @Test
+    fun theSoftFrontierStillRaisesNewBandPrices() {
+        val now = 80_000_000L
+        val inherited = Backup(qualifiedAppPeaks = mapOf("memo" to 25),
+            cloud = Cloud(items = mapOf(CloudItem.SyncValue to 35)))
+        val hard = Engine(RuleSet(frontierPrices = true)).newGame(now, 17, inherited)
+        val soft = Engine(RuleSet(frontierPrices = true, frontierBudgetPerDigit = 5))
+        val state = soft.newGame(now, 17, inherited)
+        val bounded = checkNotNull(state.frontierPricePermille)
+        assertTrue(bounded > BigInteger.valueOf(1_000))
+        assertTrue(bounded < checkNotNull(hard.frontierPricePermille))
+        val high = state.copy(appLevels = state.appLevels + ("memo" to 49))
+        assertTrue(soft.upgradePrice(high, "memo") > soft.rules.upgradePrice(Catalog.app("memo"), 49))
+    }
+}
