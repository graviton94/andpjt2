@@ -0,0 +1,16 @@
+package com.graviton94.notificationcleaner.core
+
+import java.math.BigInteger
+
+/** Repays an earned file layer only during manual play in the opening run after a sync. */
+enum class SyncCarry(val sharePermille: Int, val fullRateWindowMs: Long, val fadeStartsAt: Int) {
+    Linear35(350, 60_000, 1),
+    Hold65(650, 30_000, 35),
+    Hold90(900, 12_000, 50);
+
+    fun weight(level: Int, until: Int): Long =
+        (until - maxOf(level, fadeStartsAt)).coerceAtLeast(0) * 1_000L / (until - fadeStartsAt).coerceAtLeast(1)
+}
+
+internal fun stakePortion(amount: BigInteger, permille: Long) =
+    amount * BigInteger.valueOf(permille) / BigInteger.valueOf(1_000)
