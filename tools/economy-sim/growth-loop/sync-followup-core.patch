@@ -0,0 +1,118 @@
+package com.graviton94.notificationcleaner.core
+
+import java.math.BigInteger
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertNotNull
+import kotlin.test.assertTrue
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+
+class SyncCarryContractTest {
+    private val now = 800_000_000L
+
+    @Test
+    fun paidSyncStartsCarryThatExpiresAtLv60AndSurvivesSave() {
+        val rules = RuleSet(syncCarry = SyncCarry.Hold65, productivePrestige = true, repeatSync = true,
+            growthOffer = GrowthOffer.Discount)
+        val engine = Engine(rules)
+        val active = engine.newGame(now, 12).copy(level = 100, runEarned = rules.levelP(100), prestigePlayMs = 2_000_000L)
+        val fresh = assertNotNull(engine.sync(active, now))
+        assertTrue(fresh.carryPPerSecond.signum() > 0)
+        assertEquals(active.runEarned, fresh.backup.cloud.carryRecordP)
+        val restored = SaveCodec.decode(SaveCodec.encode(fresh))
+        assertEquals(fresh.carryPPerSecond, restored.carryPPerSecond)
+        assertEquals(0, engine.carryPPerSecond(restored.copy(level = 60)).signum())
+        assertTrue(engine.carryPPerSecond(restored.copy(level = 50)) < engine.carryPPerSecond(restored.copy(level = 35)))
+        val session = WebSession(engine, restored, now)
+        val panel = Json.parseToJsonElement(session.panel(now)).jsonObject
+        val carry = panel.getValue("carry").jsonObject
+        assertEquals(carry, panel.getValue("state").jsonObject.getValue("carry"))
+        assertEquals(carry, Json.parseToJsonElement(session.snapshot(now)).jsonObject.getValue("carry"))
+        assertEquals("0.65", carry.getValue("ratio").jsonPrimitive.content)
+        assertEquals("60", carry.getValue("untilLevel").jsonPrimitive.content)
+        assertTrue("pPerSec" in carry && "pPerSecShort" in carry)
+
+        val target = assertNotNull(engine.autoTarget(restored, now))
+        val manual = assertNotNull(engine.swipe(restored, target, now, Actor.Player)).state
+        assertTrue(manual.carryPaidP.signum() > 0)
+        assertEquals(0, assertNotNull(engine.swipe(restored, target, now, Actor.Auto)).state.carryPaidP.signum())
+        val repeatTarget = assertNotNull(engine.autoTarget(manual, now))
+        val repeat = assertNotNull(engine.swipe(manual, repeatTarget, now, Actor.Player)).state
+        assertEquals(manual.carryPaidP, repeat.carryPaidP)
+
+        val organic = rules.levelP(35)
+        val tallied = manual.copy(level = 60, runEarned = organic + manual.carryPaidP, prestigePlayMs = 0)
+        val comparison = tallied.copy(runEarned = organic, carryPaidP = BigInteger.ZERO)
+        assertEquals(engine.factoryResetPaid(comparison, now, true), engine.factoryResetPaid(tallied, now, true))
+        val postReset = assertNotNull(engine.factoryReset(tallied, now))
+        assertEquals(0, postReset.carryPPerSecond.signum())
+        assertEquals(active.runEarned, postReset.backup.cloud.carryRecordP)
+    }
+
+    @Test
+    fun returnImprovesPaymentWithinTheOldWindowAndPreservesTheReceipt() {
+        val rules = RuleSet(growthOffer = GrowthOffer.Discount, exReturnPerSkuPermille = 160, exReturnMemory = true)
+        val engine = Engine(rules)
+        val state = engine.newGame(now, 1).copy(level = 36, runEarned = rules.levelP(36),
+            earnRate = BigInteger.valueOf(1_000_000), backup = Backup(cloud = Cloud(exReturnRecordRate = BigInteger.valueOf(2_000_000)))).withAccount { it.copy(ownedEx = ExOffers.ids.toSet()) }
+        val base = Engine(rules.copy(exReturnPerSkuPermille = 0))
+        val sixHours = 6 * 3_600_000L
+        assertTrue(engine.settleOfflineWithBonus(state, sixHours, now).paid > base.settleOfflineWithBonus(state, sixHours, now).paid)
+        for (hours in listOf(6L, 15L)) {
+            val away = hours * 3_600_000L
+            val response = WebSession(engine, state, now).offline(away, now)
+            val receipt = Json.parseToJsonElement(response).jsonObject
+            assertEquals(away.toString(), receipt.getValue("awayMs").jsonPrimitive.content)
+            assertEquals("8820000", receipt.getValue("exExtraOfflineCapMs").jsonPrimitive.content)
+            assertEquals(if (hours == 6L) "0" else "8820000", receipt.getValue("exExtraEligibleMs").jsonPrimitive.content)
+            assertTrue(listOf("paid", "paidShort", "basePaid", "basePaidShort", "bonusPaid", "bonusPaidShort",
+                "exExtraPShort", "offlineBonus").all { it in receipt })
+            System.getenv("NC_SYNC_UI_OUT")?.let { target ->
+                val dir = java.io.File(target).also { it.mkdirs() }
+                java.io.File(dir, "return-${hours}h.json").writeText(response + "\n")
+            }
+        }
+    }
+
+    @Test
+    fun speedWelcomePaysFirstPositiveManualSwipesOncePerAccount() {
+        val engine = Engine(RuleSet(speedWelcomePermille = 2_000))
+        val state = engine.newGame(now, 1).withAccount { it.copy(speedPass = SpeedPass.Turbo, speedPassUntil = now + 3_600_000) }
+        val target = assertNotNull(engine.autoTarget(state, now))
+        val fresh = assertNotNull(engine.swipe(state, target, now, Actor.Player))
+        val used = state.withAccount { it.copy(speedWelcomeSwipes = 3) }
+        val original = assertNotNull(engine.swipe(used, target, now, Actor.Player))
+        assertEquals(original.earned * BigInteger.TWO, fresh.earned)
+        assertEquals(1, SaveCodec.decode(SaveCodec.encode(fresh.state)).account.speedWelcomeSwipes)
+        assertEquals(0, assertNotNull(engine.swipe(state, target, now, Actor.Auto)).state.account.speedWelcomeSwipes)
+        assertEquals(3, original.state.account.speedWelcomeSwipes)
+    }
+
+    @Test
+    fun pacedPriceUsesTheSameQuoteForAffordabilityAndDebit() {
+        val rules = RuleSet(appUpgradePacePermille = 250, filePriceGrowthScalePermille = 3_000)
+        val engine = Engine(rules)
+        val state = engine.newGame(now, 1).copy(appLevels = Catalog.starter.associateWith { 3 }, swipes = 5,
+            upgradeRateReference = BigInteger.valueOf(1_000_000))
+        val opening = engine.upgradePrice(state, "memo")
+        assertEquals(BigInteger.valueOf(250_000), opening)
+        assertEquals(BigInteger.valueOf(2_000_000), engine.upgradePrice(state.copy(prestigePlayMs = 600_001), "memo"))
+        val wallet = state.copy(wallet = opening)
+        assertEquals(BigInteger.ZERO, engine.upgrade(wallet, "memo").wallet)
+        assertEquals(3, engine.upgrade(wallet.copy(wallet = opening - BigInteger.ONE), "memo").appLevels.getValue("memo"))
+        assertTrue(rules.backupPrice(BackupItem.Value, 9) > RuleSet().backupPrice(BackupItem.Value, 9))
+
+        val trackedRules = RuleSet(fileShopRecordFloor = true, fileShopCarryRecord = true, productivePrestige = true)
+        val tracked = Engine(trackedRules)
+        val old = tracked.newGame(now, 11, Backup(baseFilesClaimed = BigInteger.valueOf(2_000_000)))
+            .copy(level = 61, runEarned = trackedRules.levelP(61), prestigePlayMs = 1_500_000)
+        val cycle = assertNotNull(tracked.sync(old, now))
+        assertTrue(cycle.backup.cloud.fileShopPreviousCycleBasis >= BigInteger.valueOf(2_000_000))
+        val live = cycle.copy(level = 25, runEarned = trackedRules.levelP(25), prestigePlayMs = 720_000)
+        val reset = assertNotNull(tracked.factoryReset(live, now))
+        assertEquals(cycle.backup.cloud.fileShopPreviousCycleBasis, reset.backup.fileShopRecordBasis)
+        assertTrue(tracked.backupPrice(reset, BackupItem.Value) >= reset.backup.fileShopRecordBasis / BigInteger.valueOf(5))
+    }
+}
