{
  "$comment": "알림 청소부 디자인 토큰 정본 v1. 값 단위: dp(크기), sp(글자), ms(시간). 색은 #RRGGBB 또는 #RRGGBBAA. design-system.md 참고.",
  "version": 1,
  "font": {
    "family": "Pretendard",
    "license": "SIL OFL 1.1",
    "numbers": "tabular (tnum)"
  },
  "type": {
    "display":  { "size": 44, "line": 48, "weight": 700, "tracking": -0.03, "use": "P 지갑, 패널 시계" },
    "headline": { "size": 28, "line": 34, "weight": 700, "tracking": -0.02, "use": "총 배율, 결과 숫자" },
    "title":    { "size": 17, "line": 22, "weight": 650, "tracking": -0.01, "use": "큰 버튼 제목, 시트 제목" },
    "body":     { "size": 14, "line": 20, "weight": 600, "tracking": -0.01, "use": "알림 앱 이름" },
    "bodySub":  { "size": 12.5, "line": 18, "weight": 400, "tracking": 0, "use": "알림 내용" },
    "label":    { "size": 12.5, "line": 16, "weight": 600, "tracking": 0, "use": "원형 타일 이름" },
    "caption":  { "size": 11.5, "line": 14, "weight": 500, "tracking": 0, "use": "시간, 보조 수치" },
    "combo":    { "size": 40, "line": 40, "weight": 900, "tracking": -0.02, "use": "연쇄 문구 (연출 전용)" }
  },
  "radius": { "tile": 999, "pill": 999, "card": 20, "panel": 30, "sheet": 32, "chip": 10, "icon": 12 },
  "space": { "xs": 4, "s": 8, "m": 12, "l": 16, "xl": 20, "xxl": 24, "screen": 18 },
  "size": { "tile": 58, "tileSmall": 50, "touchMin": 48, "card": 62, "appIcon": 38, "statusBar": 42, "slider": 46, "navHandle": 5 },
  "glass": {
    "$comment": "blur는 Android 12(API 31)+에서 배경 블러. 그 아래는 blur 없이 fallbackFill을 쓴다.",
    "levels": ["panel", "card", "raised"]
  },
  "motion": {
    "$comment": "시작 실험값 (조사 E·F, 검증된 표준값 아님). 화면 전체 셰이크는 0, 카드 영역만 흔든다. 움직임 줄이기에서 셰이크 0.",
    "tap": 90, "toggle": 160, "sheetOpen": 320, "cardEnter": 220,
    "swipeExit": 110, "mergePop": 140, "mergePopScale": 1.06,
    "hitStopBurst": 28, "chainStep": 85, "chainStepMin": 45, "overloadWave": 180,
    "shakeCardDp": 1.5, "shakeCriticalDp": 3, "shakeScreenDp": 0,
    "pitchPerChainSemitone": 0.5, "pitchMaxSemitone": 4,
    "countUp": 360, "countUpBig": 650,
    "springDamping": 0.72, "springStiffness": 520
  },
  "haptics": {
    "$comment": "1차 View.performHapticFeedback → API29 Predefined → API30 Composition(지원 확인) → 무진동. 윙윙거림보다 무진동.",
    "swipe": "KEYBOARD_TAP", "merge": "PRIMITIVE_TICK", "burst": "PRIMITIVE_CLICK+TICK",
    "overload": "PRIMITIVE_THUD|LOW_TICK", "reset": "DOUBLE_CLICK"
  },
  "modes": {
    "light": {
      "name": "데이라이트 (기본)",
      "background": { "base": "#EEF1F7", "top": "#E3ECFF", "blobA": "#9DB8FF66", "blobB": "#FFD2AE55" },
      "glass": {
        "panel":  { "fill": "#FFFFFF8C", "fallbackFill": "#F7F9FCF2", "blur": 24, "border": "#FFFFFFB3", "shadow": "#1E2A501A" },
        "card":   { "fill": "#FFFFFFB8", "fallbackFill": "#FFFFFFF5", "blur": 18, "border": "#FFFFFFCC", "shadow": "#1E2A5014" },
        "raised": { "fill": "#FFFFFFE6", "fallbackFill": "#FFFFFF",   "blur": 12, "border": "#FFFFFF",   "shadow": "#1E2A5026" }
      },
      "color": {
        "accent": "#3867F0", "accentSoft": "#3867F02E", "onAccent": "#FFFFFF",
        "chain": "#FF8A1F", "chainGlow": "#FFB15C", "interrupt": "#EF4444", "success": "#18A957",
        "tileOff": "#1E2A5014", "onTileOff": "#3C4250",
        "text": "#16181D", "textSub": "#5F6674", "textFaint": "#9AA1AD",
        "track": "#1E2A501A", "trackFill": "#C6D3F7", "scrim": "#0A0F1E66", "flash": "#0B1020"
      }
    },
    "dark": {
      "name": "앰버 골드 (다크 모드)",
      "background": { "base": "#15120F", "top": "#2A2119", "blobA": "#FF9F3F40", "blobB": "#F5C45129" },
      "glass": {
        "panel":  { "fill": "#FFFFFF12", "fallbackFill": "#2A2520F2", "blur": 24, "border": "#FFFFFF1F", "shadow": "#00000066" },
        "card":   { "fill": "#FFFFFF17", "fallbackFill": "#312B25F5", "blur": 18, "border": "#FFFFFF1A", "shadow": "#00000055" },
        "raised": { "fill": "#FFFFFF24", "fallbackFill": "#3A332C",   "blur": 12, "border": "#FFFFFF2E", "shadow": "#00000080" }
      },
      "color": {
        "accent": "#EFA03F", "accentSoft": "#EFA03F33", "onAccent": "#1E1408",
        "chain": "#FFD66B", "chainGlow": "#F6C453", "interrupt": "#FF6B4A", "success": "#5BD68A",
        "tileOff": "#FFFFFF1F", "onTileOff": "#E9E3DC",
        "text": "#F6F1EA", "textSub": "#B3A89B", "textFaint": "#7D746A",
        "track": "#FFFFFF14", "trackFill": "#7A6A58", "scrim": "#00000080", "flash": "#FFF4D6"
      }
    }
  }
}
